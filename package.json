{
  "name": "uos-health",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": { "bun": "1.4.0" },
  "scripts": {
    "dev": "bun --watch bun.ts",
    "start": "bun bun.ts",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.bun.json",
    "test": "bun --no-env-file test tests/bun_test.ts --timeout 30000",
    "test:workers": "bun --no-env-file test tests/worker_test.ts --timeout 60000",
    "check": "bun run typecheck && bun run test && bun run test:workers",
    "deploy:types": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_SEND_METRICS=false wrangler types worker-configuration.d.ts",
    "deploy:dry-run": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "miniflare": "5.20261012.1-beta",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
